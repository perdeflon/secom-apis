          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CertificateRevocation": {
        "required": [
          "revocationReason",
          "revokedAt"
        ],
        "type": "object",
        "properties": {
          "revocationReason": {
            "$ref": "#/components/schemas/RevocationReasonEnum"
          },
          "revokedAt": {
            "type": "string",
            "description": "The date the certificate revocation should be activated.",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": ""
      },
      "ResponseObject": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Success or error response message"
          }
        },
        "additionalProperties": false
      },
      "RevocationReasonEnum": {
        "enum": [
          "unspecified",
          "keycompromise",
          "cacompromise",
          "affiliationchanged",
          "superseded",
          "cessationofoperation",
          "certificatehold",
          "privilegewithdrawn",
          "aacompromise"
        ],
        "type": "string",
        "description": "The reason the certificates has been revoked"
      }
    }
  }
