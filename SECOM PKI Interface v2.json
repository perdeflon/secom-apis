    "/v2/revoke/{certId}": {
      "post": {
        "tags": [
          "Certificate"
        ],
        "summary": "",
        "parameters": [
          {
            "name": "certId",
            "in": "path",
            "description": "The serial number of the certificate given in decimal",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateRevocation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseObject"
                }
              }
            }
          },
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
