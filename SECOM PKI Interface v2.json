    "/v2/publicKey/": {
      "get": {
        "tags": [
          "Certificate"
        ],
        "summary": "",
        "parameters": [
          {
            "name": "certThumbprint",
            "in": "query",
            "description": "The thumbprint of claimed public key, Base64 encoded, SHA256",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "certId",
            "in": "query",
            "description": "The serial number of the certificate given in decimal",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "identityId",
            "in": "query",
            "description": "The identifier of the identity related to the certificate, e.g. a MRN",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
